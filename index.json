          ],
          "default": "distilgpt2",
          "required": true,
          "description": "Larger models want a GPU runtime."
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "default": "The best thing about running models on your own runtime is",
          "required": true
        },
        {
          "key": "max_new_tokens",
          "label": "Max new tokens",
          "type": "integer",
          "default": 60,
          "required": true
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "default": 0.7,
          "required": true,
          "description": "0 for greedy decoding."
        }
      ],
      "source": "notebooks/hf-text-generation/notebook.py",
