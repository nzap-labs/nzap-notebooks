    {
      "slug": "print-notebook",
      "title": "Print Notebook",
      "description": "The smallest useful notebook: prints whatever string you give it.",
      "tags": [
        "starter"
      ],
      "author": "NZAP Labs",
      "params": [
        {
          "key": "string_to_print",
          "label": "String to print",
          "type": "string",
