    {
      "slug": "hf-sentiment",
      "title": "Sentiment Analysis (Hugging Face)",
      "description": "Scores each line of text as positive or negative with a DistilBERT classifier.",
      "tags": [
        "app",
        "inference",
        "nlp",
        "huggingface"
      ],
      "author": "NZAP Labs",
      "params": [
        {
          "key": "text",
          "label": "Text (one item per line)",
          "type": "text",
          "default": "I love this!\nThis was a waste of time.",
          "required": true
        }
      ],
      "source": "notebooks/hf-sentiment/notebook.py",
      "sha256": "fce530dab467231d0cfd47ad546a2e382a2ca487965d3fc9e24219a789354610",
      "app": {
        "format": "nzap-app/1",
        "icon": "smile",
        "category": "text",
        "tagline": "Score how positive or negative each line of text is.",
        "runtime": {
          "accelerator": "CPU",
          "supported": [
            "CPU",
            "T4",
            "L4",
            "A100",
            "H100",
            "G4"
          ]
        },
        "estimates": {
          "setup": 20,
          "run": 1,
          "measuredOn": "CPU",
          "runNote": "for a few dozen lines"
        },
        "runLabel": "Score sentiment",
        "inputs": [
          {
            "param": "text",
            "widget": "textarea",
            "rows": 8,
            "placeholder": "One review, tweet or sentence per line"
          }
        ],
        "outputs": [
          {
            "id": "scores",
            "kind": "table",
            "label": "Scores"
          }
        ],
        "examples": [
          {
            "label": "Product reviews",
            "values": {
              "text": "Setup took thirty seconds. Love it.\nThe battery died after a day.\nIt's fine, I guess.\nBest purchase this year!"
            }
          }
        ],
        "links": [
          {
            "label": "Model card",
            "url": "https://huggingface.co/distilbert/distilbert-base-uncased-finetuned-sst-2-english"
          }
        ],
        "license": "Apache-2.0"
      }
