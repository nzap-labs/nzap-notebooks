    {
      "slug": "hf-sentiment",
      "title": "Sentiment Analysis (Hugging Face)",
      "description": "Scores each line of text as positive or negative with a DistilBERT classifier.",
      "tags": [
        "inference",
        "nlp",
        "huggingface"
      ],
      "author": "NZAP Labs",
      "params": [
        {
          "key": "text",
          "label": "Text (one item per line)",
          "type": "text",
          "default": "I love this!\nThis was a waste of time.",
          "required": true
        }
      ],
      "source": "notebooks/hf-sentiment/notebook.py",
      "sha256": "04894f2c801d0ed6b1c82c3e303b2fde7936e972176d25822725a5f7c7a34b58"
    },
    {
      "slug": "hf-text-generation",
      "title": "Text Generation (Hugging Face)",
      "description": "Runs a Hugging Face text-generation model on your runtime and prints the continuation.",
      "tags": [
        "inference",
        "llm",
        "huggingface"
      ],
      "author": "NZAP Labs",
      "params": [
        {
          "key": "model",
          "label": "Model",
          "type": "select",
          "options": [
            "distilgpt2",
            "gpt2",
            "Qwen/Qwen2.5-0.5B-Instruct"
          ],
          "default": "distilgpt2",
          "required": true,
          "description": "Larger models want a GPU runtime."
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "default": "The best thing about running models on your own runtime is",
          "required": true
        },
        {
          "key": "max_new_tokens",
          "label": "Max new tokens",
          "type": "integer",
          "default": 60,
          "required": true
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "default": 0.7,
          "required": true,
          "description": "0 for greedy decoding."
        }
      ],
      "source": "notebooks/hf-text-generation/notebook.py",
      "sha256": "7657ebb30516a13b90495ec7c5aebf2a605321086a1e15657a4ab815db9f881a"
    }
  ]
}
