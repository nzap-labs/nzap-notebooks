      "app": {
        "format": "nzap-app/1",
        "icon": "audio-lines",
        "category": "audio",
        "tagline": "Turn text into lifelike speech in seconds.",
        "runtime": {
          "accelerator": "T4",
          "supported": [
            "CPU",
            "T4",
            "L4",
            "A100",
            "H100",
            "G4"
          ]
        },
        "estimates": {
          "setup": 60,
          "run": 3,
          "measuredOn": "T4",
          "runNote": "for about 200 characters"
