    {
      "slug": "hf-text-generation",
      "title": "Text Generation (Hugging Face)",
      "description": "Runs a Hugging Face text-generation model on your runtime and prints the continuation.",
      "tags": [
        "inference",
        "llm",
        "huggingface"
      ],
      "author": "NZAP Labs",
      "params": [
        {
          "key": "model",
          "label": "Model",
          "type": "select",
          "options": [
